rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Inspection photos: only the owner reads or writes. Images only, capped at 10 MB.
    // Photos can show plates and VINs, so there is no public or org read in the MVP.
    match /inspection-photos/{uid}/{inspectionId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Report PDFs: owner reads. Shared reports go out as time-limited signed URLs from a function.
    match /reports/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.contentType == 'application/pdf'
        && request.resource.size < 20 * 1024 * 1024;
      allow delete: if false;
    }

    // Engine sound clips: owner uploads one, a function analyses and then deletes it. MP4 only, under 30 MB.
    match /engine-clips/{uid}/{fileName} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && fileName.matches('[A-Za-z0-9-]{8,64}[.]mp4')
        && request.resource.contentType == 'video/mp4'
        && request.resource.size < 30 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
